{
    "manifest_version": 3,
    "name": "SpinBoxd",
    "version": "0.1.0",
    "description": "The Movie Night Extension Tool",
    "action": {
        "default_title": "SpinBoxd",
        "default_icon": "icons/icon16.png"
    },
    "background": {
        "service_worker": "service-worker.js"
    },
    "side_panel": {
        "default_path": "sidepanel/sidepanel.html"
    },
    "content_scripts": [
        
    ],
    "permissions": [
        "sidePanel"
    ],
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}
