{
    "manifest_version": 3,
    "name": "SpinBoxd",
    "version": "0.1.0",
    "description": "The Movie Night Extension Tool",
    "action": {
        "default_popup": "hello.html",
        "default_icon": "hello_extensions.png"
    },
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "content_scripts": [
        {
            "matches": [
                "https://letterboxd.com/",
                "https://letterboxd.com/*/watchlist/*"
            ],
            "js": ["content.js"]
        }
    ]
}
